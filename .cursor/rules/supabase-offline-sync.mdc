```typescript
// src/app/shared/components/sync-status/sync-status.component.ts
@Component({
  selector: 'app-sync-status',
  standalone: true,
  imports: [CommonModule, BadgeModule],
  template: `
    <div class="sync-status" [class]="syncStatus()">
      @switch (syncStatus()) {
        @case ('syncing') {
          <p-badge 
            value="Sincronizando..." 
            severity="info"
            [styleClass]="'animate-pulse'"
          />
        }
        @case ('idle') {
          @if (pendingOps() > 0) {
            <p-badge 
              [value]="pendingOps() + ' pendientes'"
              severity="warning"
            />
          } @else {
            <p-badge 
              value="✓ Sincronizado"
              severity="success"
            />
          }
        }
        @case ('conflict') {
          <p-badge 
            value="Conflicto detectado"
            severity="danger"
            (click)="showConflicts()"
          />
        }
        @case ('error') {
          <p-badge 
            value="Error de sync"
            severity="danger"
          />
        }
      }
      
      @if (lastSync()) {
