### Servicio de Notificaciones Locales

```typescript
// src/app/core/notifications/notification.service.ts
import { LocalNotifications } from '@capacitor/local-notifications';

@Injectable({ providedIn: 'root' })
export class NotificationService {
  async scheduleBlockReminder(block: DailyBlock) {
    const notificationTime = this.getNotificationTime(block.start_time);
    
    await LocalNotifications.schedule({
      notifications: [{
        title: `Próximo bloque: ${block.name}`,
        body: `Comienza en 5 minutos`,
        id: parseInt(block.id.slice(0, 8), 16), // UUID to number
        schedule: { at: notificationTime },
        sound: 'default',
        actionTypeId: 'BLOCK_START',
        extra: { blockId: block.id }
      }]
    });
  }
  
  async requestPermissions() {
    const result = await LocalNotifications.requestPermissions();
    return result.display === 'granted';
  }
}
```

### Storage Offline (Preferences)

```typescript
// src/app/core/storage/storage.service.ts
import { Preferences } from '@capacitor/preferences';

@Injectable({ providedIn: 'root' })
export class StorageService {
  async set(key: string, value: any): Promise<void> {
    await Preferences.set({
      key,
      value: JSON.stringify(value)
    });
  }
  
  async get<T>(key: string): Promise<T | null> {
    const { value } = await Preferences.get({ key });
    return value ? JSON.parse(value) : null;
  }
  
  async remove(key: string): Promise<void> {
    await Preferences.remove({ key });
  }
}
```

