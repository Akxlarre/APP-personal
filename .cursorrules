## 🗄️ Supabase: Reglas de Integración

### 1. Tipos Auto-Generados (Obligatorio)

```bash
# Generar tipos desde schema
npx supabase gen types typescript --project-id YOUR_PROJECT_ID > src/app/core/supabase/database.types.ts
```

```typescript
// ✅ Uso de tipos generados
import { Database } from '@core/supabase/database.types';

type DailyBlock = Database['public']['Tables']['daily_blocks']['Row'];
type DailyBlockInsert = Database['public']['Tables']['daily_blocks']['Insert'];
type DailyBlockUpdate = Database['public']['Tables']['daily_blocks']['Update'];
```

### 2. Service Layer (Single Source of Truth)

```typescript
// src/app/core/supabase/supabase.service.ts
@Injectable({ providedIn: 'root' })
export class SupabaseService {
  private supabase: SupabaseClient<Database>;
  
  constructor() {
    this.supabase = createClient<Database>(
      environment.supabaseUrl,
      environment.supabaseAnonKey
    );
  }
  
  // Auth
  get auth() {
    return this.supabase.auth;
  }
  
  // Realtime subscription helper
  subscribeToTable<T extends keyof Database['public']['Tables']>(
    table: T,
    callback: (payload: RealtimePostgresChangesPayload<any>) => void
  ) {
    return this.supabase
      .channel(`${table}_changes`)
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table },
        callback
      )
      .subscribe();
  }
}
```

### 3. Repository Pattern por Entidad

```typescript
// src/app/features/blocks/services/blocks.repository.ts
@Injectable({ providedIn: 'root' })
export class BlocksRepository {
  private supabase = inject(SupabaseService);
  
  async getDailyBlocks(userId: string, date: string): Promise<DailyBlock[]> {
    const { data, error } = await this.supabase
      .from('daily_blocks')
      .select('*')
      .eq('user_id', userId)
      .eq('date', date)
      .order('start_time', { ascending: true });
    
    if (error) throw error;
    return data;
  }
  
  async completeBlock(blockId: string, note?: string): Promise<void> {
    const { error } = await this.supabase
      .from('daily_blocks')
      .update({
        status: 'completed',
        completion_note: note,
        completed_at: new Date().toISOString()
      })
      .eq('id', blockId);
    
    if (error) throw error;
  }
}
```

### 4. Row Level Security (RLS) - Obligatorio

```sql
-- Ejemplo de política RLS (ejecutar en Supabase SQL Editor)
-- Users solo pueden ver sus propios bloques
CREATE POLICY "Users can view own blocks"
  ON daily_blocks
  FOR SELECT
  USING (auth.uid() = user_id);

-- Users pueden ver bloques compartidos donde están invitados
CREATE POLICY "Users can view shared blocks"
  ON daily_blocks
  FOR SELECT
  USING (
    id IN (
      SELECT block_id FROM shared_blocks
      WHERE invited_user_id = auth.uid() AND status = 'accepted'
    )
  );
```

