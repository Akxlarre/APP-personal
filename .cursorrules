## 🔥 Reglas de Código Angular

### 1. SIEMPRE Standalone Components
```typescript
// ❌ MAL - NgModules están prohibidos
@NgModule({
  declarations: [BlockCardComponent],
  imports: [CommonModule]
})
export class BlocksModule {}

// ✅ BIEN
@Component({
  selector: 'app-block-card',
  standalone: true,
  imports: [CommonModule, CardModule, ButtonModule],
  templateUrl: './block-card.component.html',
  changeDetection: ChangeDetectionStrategy.OnPush // OBLIGATORIO
})
export class BlockCardComponent {}
```

### 2. NgRx Signals para Estado Global
```typescript
// ✅ Store con Signals
import { signalStore, withState, withMethods } from '@ngrx/signals';

export const HabitsStore = signalStore(
  { providedIn: 'root' },
  withState<HabitsState>({
    streaks: [],
    debtedBlocks: [],
    freezeCount: 2
  }),
  withMethods((store) => ({
    addStreak(blockId: string) {
      // Lógica inmutable
    },
    useFreeze() {
      patchState(store, { freezeCount: store.freezeCount() - 1 });
    }
  }))
);

// ✅ Uso en componente
export class DashboardComponent {
  habitsStore = inject(HabitsStore);
  
  streaks = this.habitsStore.streaks; // Signal readonly
}
```

### 3. Inyección de Dependencias con `inject()`
```typescript
// ❌ MAL - Constructor injection (legacy)
constructor(
  private supabase: SupabaseService,
  private router: Router
) {}

// ✅ BIEN - Function-based injection
export class BlockListComponent {
  private supabase = inject(SupabaseService);
  private router = inject(Router);
  private route = inject(ActivatedRoute);
  
  // Computed signals
  blocks = computed(() => this.supabase.blocks());
}
```

### 4. Formularios Reactivos (NO Template-driven)
```typescript
// ✅ Reactive Forms con Typed Forms
import { FormBuilder, FormGroup, Validators } from '@angular/forms';

export class TemplateFormComponent {
  private fb = inject(FormBuilder);
  
  templateForm = this.fb.group({
    name: ['', [Validators.required, Validators.minLength(3)]],
    blocks: this.fb.array([]) // FormArray para bloques dinámicos
  });
  
  get blocks() {
    return this.templateForm.get('blocks') as FormArray;
  }
  
  addBlock() {
    this.blocks.push(this.fb.group({
      name: ['', Validators.required],
      startTime: ['', Validators.required],
      endTime: ['', Validators.required]
    }));
  }
}
```

### 5. Change Detection Strategy OnPush (Obligatorio)
```typescript
@Component({
  selector: 'app-block-card',
  changeDetection: ChangeDetectionStrategy.OnPush, // SIEMPRE
  // ...
})
```

